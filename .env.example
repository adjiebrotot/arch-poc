# URL of the firm's Cloudflare Worker that proxies LLM calls (no trailing slash).
# Leave empty to use the built-in rule-based parser ("Offline mode").
# In CI this is read from the GitHub Actions repository variable VITE_LLM_WORKER_URL.
VITE_LLM_WORKER_URL=

# OpenStreetMap services for "Find it on a map" (all optional; defaults shown).
# The public OSM tile server and Nominatim are meant for light use: use your own or a
# commercial provider for real traffic.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
